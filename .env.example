# =============================================================================
# Construction ERP — переменные окружения (ТЗ §57-59).
# Секреты НЕ хранятся в git. Этот файл — только шаблон.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=construction_erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=construction_erp
DATABASE_URL=postgresql://construction_erp:change-me-strong-password@postgres:5432/construction_erp?schema=public

# --- Backend (NestJS) ---
PORT=3000
NODE_ENV=development

# Origin опубликованного React SPA. В TEST это Render URL. Backend использует
# значение как адрес безопасного redirect после проверки Bitrix24 placement.
FRONTEND_URL=https://your-frontend.example.com

# CORS origins для браузерных вызовов REST API. Несколько origins разделяются
# запятыми. Это НЕ Bitrix portal domain: браузерные API-запросы идут из SPA.
# Если переменная не задана, backend использует origin из FRONTEND_URL;
# если не задано и FRONTEND_URL — standalone demo сохраняет permissive CORS.
ALLOWED_WEB_ORIGINS=https://your-frontend.example.com

# Домен конкретного Bitrix24-портала БЕЗ https://. Используется только для:
# 1) CSP frame-ancestors install/launch страниц;
# 2) строгой allowlist-проверки DOMAIN входящего Bitrix24 контекста.
ALLOWED_BITRIX_DOMAIN=your-portal.bitrix24.ru

# Локальное приложение Bitrix24 (Developer resources -> Local application).
# Секреты хранятся только в secret store окружения.
BITRIX_CLIENT_ID=local.app.placeholder
BITRIX_CLIENT_SECRET=change-me-bitrix-client-secret

# Fail-closed feature flag для installation flow.
# false — /api/bitrix/install и /api/bitrix/install-ui не создают установку.
# true включать только на TEST-портале на время контролируемой установки.
BITRIX_INSTALL_ENABLED=false

# Локальное demo-файлохранилище. В Railway TEST путь должен быть на
# смонтированном persistent volume.
LOCAL_FILE_STORAGE_PATH=/app/storage/local-uploads

# 32-байтный ключ (base64 или hex) для AES-256-GCM шифрования OAuth-токенов.
# Генерация: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# --- Auth boundary ---
# demo   — X-Tenant-Id/X-Bitrix-User-Id; только standalone development/demo.
# bitrix — только Authorization: Bearer <Construction ERP session token>.
#          Session token выпускает POST /api/bitrix/launch после проверки
#          member_id + APPLICATION_TOKEN и user.current через AUTH_ID.
AUTH_MODE=demo

# HMAC-SHA256 секрет собственных короткоживущих session tokens.
# Обязателен при AUTH_MODE=bitrix. Минимум 16 символов.
# Генерация: openssl rand -base64 32
SESSION_SECRET=change-me-session-secret-min-16-chars

# --- Frontend (Vite build-time) ---
# Полный публичный URL backend без завершающего slash. В deployed browser
# Vite встраивает его в bundle как __API_BASE_URL__.
VITE_API_URL=https://your-backend.example.com
