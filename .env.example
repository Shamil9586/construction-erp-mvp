# =============================================================================
# Construction ERP — переменные окружения (ТЗ §57-59).
# Секреты НЕ хранятся в git — этот файл только шаблон. Реальный .env создаётся
# локально/в секрет-хранилище (Docker secrets, Vault, CI secret store и т.п.)
# и никогда не коммитится (см. .gitignore).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=construction_erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=construction_erp
# Внутри docker-compose backend обращается к сервису "postgres" по имени.
DATABASE_URL=postgresql://construction_erp:change-me-strong-password@postgres:5432/construction_erp?schema=public

# --- Backend (NestJS) ---
PORT=3000
NODE_ENV=development

# Домен Bitrix24-портала, которому разрешено встраивать приложение в iframe
# (Helmet CSP frame-ancestors) и который разрешён в CORS. Без реального
# тестового портала оставьте плейсхолдер — REQUIRES BITRIX24 TEST PORTAL
# VERIFICATION (см. docs/bitrix24-integration.md).
ALLOWED_BITRIX_DOMAIN=your-portal.bitrix24.ru

# Локальное приложение Bitrix24 (создаётся в Bitrix24 -> Разработчикам ->
# Другое -> Локальное приложение). Пока не подключён тестовый портал,
# используются только заглушечные значения и MockBitrixAdapter.
BITRIX_CLIENT_ID=local.app.placeholder
BITRIX_CLIENT_SECRET=change-me-bitrix-client-secret

# Fail-closed feature flag для POST /bitrix/install (обработчик ONAPPINSTALL,
# см. src/bitrix/install.controller.ts, docs/bitrix24-integration.md §2).
# По умолчанию НЕ установлен -> endpoint отклоняет любой вызов и ничего не
# пишет в БД. Ставить "true" ТОЛЬКО после проверки на реальном тестовом
# портале Bitrix24 — REQUIRES BITRIX24 TEST PORTAL VERIFICATION, до этого
# момента должен оставаться не "true" в любом окружении, включая production.
BITRIX_INSTALL_ENABLED=false

# Демо/локальное файловое хранилище (MockFileStorageProvider, integrity-fix
# pass) — каталог на диске backend-контейнера/хоста, куда реально пишутся
# байты загружаемых файлов (фото инспекций и т.п.). Это НЕ production
# storage — только для среды без реального Bitrix24-портала. Реальная
# загрузка в Bitrix24.Disk (RealFileStorageProvider) остаётся отдельным
# непроверенным этапом — REQUIRES BITRIX24 TEST PORTAL VERIFICATION.
# В docker-compose путь смонтирован как именованный volume "local_uploads",
# чтобы файлы переживали пересоздание контейнера.
LOCAL_FILE_STORAGE_PATH=/app/storage/local-uploads

# 32-байтный ключ (base64 или hex) для AES-256-GCM шифрования OAuth-токенов
# в БД (см. src/bitrix/crypto.util.ts). Сгенерировать:
#   openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# --- Граница авторизации (hardening, см. docs/bitrix24-integration.md §«Auth boundary») ---
# demo   — личность берётся из заголовков X-Tenant-Id/X-Bitrix-User-Id,
#          заданных клиентом НАПРЯМУЮ. Только для разработки/демо на
#          сид-данных, НИКОГДА не для боевого/тестового Bitrix24-портала.
#          Запрещён (приложение откажется стартовать) при NODE_ENV=production.
# bitrix — личность берётся ТОЛЬКО из подписанного сессионного токена
#          (Authorization: Bearer ...), который backend сам выпускает после
#          проверки подписи Bitrix24 при открытии placement. Обязателен для
#          production. Сам обмен placement-контекста на токен —
#          REQUIRES BITRIX24 TEST PORTAL VERIFICATION, ещё не подключён.
AUTH_MODE=demo

# Секрет для подписи собственных сессионных токенов (HMAC-SHA256,
# apps/backend/src/modules/auth/session.util.ts). Обязателен при
# AUTH_MODE=bitrix. Минимум 16 символов. Сгенерировать:
#   openssl rand -base64 32
SESSION_SECRET=change-me-session-secret-min-16-chars

# --- Frontend (Vite build-time) ---
# Базовый путь API, который увидит браузер (за реверс-прокси — как правило "/api").
VITE_API_BASE_URL=/api
