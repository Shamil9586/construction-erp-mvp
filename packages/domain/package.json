{
  "name": "@construction-erp/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic domain layer: business rules, независимые от Bitrix API / React / ORM / файловой системы (см. docs/architecture.md).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
